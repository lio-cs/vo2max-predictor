GOOGLE_HEALTH_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_HEALTH_CLIENT_SECRET=your_client_secret
GOOGLE_HEALTH_REDIRECT_URI=http://localhost:3000/api/auth/callback

# AeroCoach (Gemini XPRIZE practice build) — get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
# Optional, defaults to gemini-3.5-flash-lite (comfortably inside the free tier's daily cap)
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional — leave unset to run with AeroCoach logging disabled (no-op).
# Create a GCP project + Firestore database (Always Free tier) and a service account with the
# "Cloud Datastore User" role, then paste its downloaded JSON key as a single-line string below.
FIRESTORE_PROJECT_ID=your_gcp_project_id
FIRESTORE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...", ...}

# Optional — LLM observability (token usage, latency, prompt/output inspection). Leave unset to
# run without tracing. Free tier at https://cloud.langfuse.com (or self-host).
LANGFUSE_SECRET_KEY=sk-lf-your_secret_key
LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key
LANGFUSE_BASE_URL=https://cloud.langfuse.com
